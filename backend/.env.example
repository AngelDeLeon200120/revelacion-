# Copiá este archivo como .env y completá los valores.
# En Hostinger, estas variables se cargan desde el panel de la App de Node.js
# (Sitios web -> tu dominio -> Avanzado -> Node.js -> Variables de entorno).

NODE_ENV=production
PORT=3001

# Base de datos MySQL de Hostinger
# (hPanel -> Bases de datos -> MySQL: creá la base y el usuario)
DB_HOST=localhost
DB_USER=uXXXXXXXX_revelacion
DB_PASSWORD=tu_password_de_la_base
DB_NAME=uXXXXXXXX_revelacion

# Dominios del frontend autorizados a llamar al API (separados por coma, sin barra final)
ALLOWED_ORIGINS=https://tudominio.com,https://www.tudominio.com

# URL pública del propio backend (para la imagen que va dentro de los correos)
API_PUBLIC_URL=https://api.tudominio.com

# Gmail para el envío de correos (usar una "Contraseña de aplicación", no la normal)
GMAIL_USER=tucorreo@gmail.com
GMAIL_PASS=xxxx xxxx xxxx xxxx
